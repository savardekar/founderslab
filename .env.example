# PostgreSQL connection string for production. If unset, an embedded PGlite (real Postgres, WASM)
# database is used at PGLITE_DIR for local development.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Public base URL (used in invite / password-reset links)
APP_URL=http://localhost:3000
# "1" returns invite/reset links in API responses when no mail provider is configured (never enable in production)
EXPOSE_DEV_LINKS=1
# Optional SMTP provider (see src/server/mailer.ts). Blank = emails are logged to the server console.
SMTP_URL=
MAIL_FROM=FoundersLab <no-reply@example.com>

# ── AI providers (Phase 2). Credentials live ONLY in the server environment, never in the database. ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# Optional prices (USD per million tokens) so cost/budget tracking works. Without it cost shows as "n/a" and only token limits are enforced.
# AI_MODEL_PRICING_JSON={"your-model-id":{"inputPerMTok":0,"outputPerMTok":0}}

# ── Phase 3 ──
# Optional TTF/OTF path so PDF reports can render non-Latin names (e.g. Devanagari). Without it PDFs use built-in Latin fonts and other characters print as "?". CSV always keeps all text.
# PDF_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
